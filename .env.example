# ─── Google Service Account credentials ───────────────────────────────────────
# Copy these from your service_account.json and set them in:
#   • Vercel Dashboard → Project → Settings → Environment Variables
#   • Local dev: copy this file to .env and fill in the values

GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# NOTE: The private key must keep its literal \n characters in the env var value.
# Vercel handles this correctly when you paste the key in the dashboard.
# For local .env, wrap the entire value in double quotes as shown above.
